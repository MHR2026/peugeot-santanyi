---
import Base from '../../layouts/Base.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { legal } from '../../content/legal';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} title={`${t('legal.title')} · Automòbils Vidal Santanyí`} path="legal/">
  <article class="prose mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl text-navy">{t('legal.title')}</h1>
    <Fragment set:html={legal[lang]} />
  </article>
</Base>

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { company, gallery, languages, mapsUrl, services, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const col = { es: 1, de: 2, en: 3 }[lang];
const mapEmbed = `https://www.google.com/maps?q=${company.lat},${company.lng}&z=16&hl=${lang}&output=embed`;
---
<Base lang={lang}>
  <!-- Portada -->
  <section class="relative isolate overflow-hidden bg-navy text-white">
    <img src="/images/fachada-2.webp" alt={company.name} width="720" height="540" fetchpriority="high"
         class="absolute inset-0 -z-20 h-full w-full object-cover opacity-70" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-dark via-navy-dark/75 to-navy-dark/20"></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-white/75">{t('hero.eyebrow')}</p>
      <h1 class="mt-4 max-w-2xl text-4xl leading-[1.05] sm:text-6xl">{t('hero.title')}</h1>
      <p class="mt-5 max-w-xl text-lg text-white/85">{t('hero.text')}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={company.phoneHref} class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-semibold hover:bg-accent-dark">
          <Icon name="phone" class="h-5 w-5" />{t('cta.call')} · {company.phone}
        </a>
        <a href={mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 font-semibold ring-1 ring-white/30 hover:bg-white/20">
          <Icon name="pin" class="h-5 w-5" />{t('cta.directions')}
        </a>
      </div>
    </div>
  </section>

  <!-- Datos rápidos -->
  <section id="horario" class="scroll-mt-20 border-b border-line bg-steel">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex items-start gap-3">
        <Icon name="clock" class="mt-0.5 h-6 w-6 shrink-0 text-accent" />
        <div><p class="text-xs font-semibold uppercase tracking-wider text-ink/60">{t('info.workshop')}</p><p class="text-lg font-semibold">{company.hours.workshop.join(' – ')}</p><p class="text-sm text-ink/60">{t('info.weekdays')}</p></div>
      </div>
      <div class="flex items-start gap-3">
        <Icon name="clock" class="mt-0.5 h-6 w-6 shrink-0 text-accent" />
        <div><p class="text-xs font-semibold uppercase tracking-wider text-ink/60">{t('info.office')}</p><p class="text-lg font-semibold">{company.hours.office.join(' – ')}</p><p class="text-sm text-ink/60">{t('info.weekdays')}</p></div>
      </div>
      <div class="flex items-start gap-3">
        <Icon name="phone" class="mt-0.5 h-6 w-6 shrink-0 text-accent" />
        <div><p class="text-xs font-semibold uppercase tracking-wider text-ink/60">{t('info.phone')}</p><a href={company.phoneHref} class="text-lg font-semibold hover:text-accent">{company.phone}</a></div>
      </div>
      <div class="flex items-start gap-3">
        <Icon name="pin" class="mt-0.5 h-6 w-6 shrink-0 text-accent" />
        <div><p class="text-xs font-semibold uppercase tracking-wider text-ink/60">{t('info.address')}</p><p class="font-semibold">{company.address}<br />{company.city}</p></div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent">{t('services.eyebrow')}</p>
    <h2 class="mt-3 text-3xl text-navy sm:text-4xl">{t('services.title')}</h2>
    <p class="mt-4 max-w-2xl text-lg text-ink/75">{t('services.text')}</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <li class="flex items-center gap-4 rounded-xl border border-line bg-white p-5 shadow-sm">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent"><Icon name={s[0]} /></span>
          <span class="font-semibold">{s[col]}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- El taller -->
  <section id="taller" class="scroll-mt-20 bg-steel">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent">{t('workshop.eyebrow')}</p>
          <h2 class="mt-3 text-3xl text-navy sm:text-4xl">{t('workshop.title')}</h2>
          <p class="mt-5 text-lg leading-relaxed text-ink/75">{t('workshop.text')}</p>
        </div>
        <img src="/images/fachada-1.webp" alt={company.name} width="720" height="540" loading="lazy" class="w-full rounded-2xl object-cover shadow-md" />
      </div>
      <div class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4">
        {gallery.map((src, i) => (
          <a href={src} target="_blank" class="block overflow-hidden rounded-xl">
            <img src={src} alt={`${company.name} — ${i + 1}`} width="720" height="540" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Vehículos de ocasión -->
  <section id="ocasion" class="scroll-mt-20 bg-navy text-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between">
      <div class="flex items-start gap-4">
        <Icon name="car" class="h-10 w-10 shrink-0 text-accent" />
        <div>
          <h2 class="text-2xl sm:text-3xl">{t('used.title')}</h2>
          <p class="mt-2 text-white/80">{t('used.text')}</p>
        </div>
      </div>
      <a href={company.phoneHref} class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-accent px-6 py-3 font-semibold hover:bg-accent-dark md:self-auto">
        <Icon name="phone" class="h-5 w-5" />{company.phone}
      </a>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent">{t('contact.eyebrow')}</p>
        <h2 class="mt-3 text-3xl text-navy sm:text-4xl">{t('contact.title')}</h2>
        <p class="mt-4 text-lg text-ink/75">{t('contact.text')}</p>
        <dl class="mt-8 space-y-5">
          <div class="flex gap-3"><Icon name="pin" class="h-6 w-6 shrink-0 text-accent" /><dd>{company.address}<br />{company.city}</dd></div>
          <div class="flex gap-3"><Icon name="phone" class="h-6 w-6 shrink-0 text-accent" /><dd><a class="font-semibold hover:text-accent" href={company.phoneHref}>{company.phone}</a></dd></div>
          <div class="flex gap-3"><Icon name="mail" class="h-6 w-6 shrink-0 text-accent" /><dd><a class="break-all hover:text-accent" href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          <div class="flex gap-3"><Icon name="clock" class="h-6 w-6 shrink-0 text-accent" />
            <dd><span class="font-semibold">{t('info.weekdays')}</span><br />{t('info.workshop')}: {company.hours.workshop.join(' – ')}<br />{t('info.office')}: {company.hours.office.join(' – ')}</dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={company.phoneHref} class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-semibold text-white hover:bg-accent-dark"><Icon name="phone" class="h-5 w-5" />{t('cta.call')}</a>
          <a href={`mailto:${company.email}`} class="inline-flex items-center gap-2 rounded-full border border-navy px-6 py-3 font-semibold text-navy hover:bg-navy hover:text-white"><Icon name="mail" class="h-5 w-5" />{t('cta.email')}</a>
        </div>
      </div>
      <!-- Mapa: Google Maps solo se carga si el visitante lo pide (sin cookies de terceros por defecto) -->
      <div class="relative min-h-[360px] overflow-hidden rounded-2xl bg-steel ring-1 ring-line" data-map={mapEmbed}>
        <img src="/images/fachada-3.webp" alt="" width="720" height="540" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-40" />
        <div class="relative flex h-full min-h-[360px] items-center justify-center p-6"><div class="flex max-w-sm flex-col items-center gap-3 rounded-2xl bg-white/95 p-6 text-center shadow-lg">
          <button type="button" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 font-semibold text-white hover:bg-navy-dark"><Icon name="pin" class="h-5 w-5" />{t('map.button')}</button>
          <a href={mapsUrl} target="_blank" rel="noopener" class="text-sm font-semibold text-navy underline">{t('cta.directions')} ↗</a>
          <p class="max-w-xs text-xs text-ink/70">{t('map.note')}</p>
        </div></div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
      box.querySelector('button')?.addEventListener('click', () => {
        box.innerHTML = `<iframe src="${box.dataset.map}" title="Google Maps" class="absolute inset-0 h-full w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
      });
    });
  </script>
</Base>
